# =============================================================================
# CareerForge AI — environment configuration (demo-friendly defaults)
# =============================================================================
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env            # macOS / Linux
#     Copy-Item .env.example .env     # Windows PowerShell
#
# The DEFAULTS below run the flagship demo with ONLY Python + Node — no Docker,
# no database, no Qdrant, no Ollama, no GPU. Every value here is optional; the
# backend (careerforge_api) already bakes in these same defaults.
#
# Precedence: process env vars > this .env file > built-in defaults.
#
# Backend settings use the CAREERFORGE_ prefix (see apps/api/careerforge_api/
# config.py). Feature flags use the CAREERFORGE_FLAG_ prefix. Frontend build-time
# values use the NEXT_PUBLIC_ prefix (Next.js convention).
# =============================================================================

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
# Runtime mode. `demo` runs the scripted, dependency-free mission simulation.
# Other values (`local`, `production`) expect the real services below.
CAREERFORGE_APP_ENV=demo
CAREERFORGE_APP_NAME=CareerForge AI
CAREERFORGE_VERSION=1.0.0

# -----------------------------------------------------------------------------
# HTTP server (backend)
# -----------------------------------------------------------------------------
CAREERFORGE_HOST=127.0.0.1
CAREERFORGE_PORT=8000
CAREERFORGE_API_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins (the Next.js dev server).
CAREERFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Feature flags (SAFETY: both default to false)
# -----------------------------------------------------------------------------
# When false, the platform never writes to GitHub. The approval flow only saves
# a draft locally and always returns github_write: false.
CAREERFORGE_FLAG_GITHUB_WRITES=false

# When false, untrusted repository code is NEVER executed. Do NOT enable without
# a hardened container sandbox in place (see docs/THREAT_MODEL.md).
CAREERFORGE_FLAG_REPOSITORY_EXECUTION=false

# -----------------------------------------------------------------------------
# Agent orchestration
# -----------------------------------------------------------------------------
# Maximum number of agents allowed to run concurrently.
CAREERFORGE_MAX_AGENT_CONCURRENCY=4

# -----------------------------------------------------------------------------
# External service URLs (ONLY used when CAREERFORGE_APP_ENV != demo)
# -----------------------------------------------------------------------------
# In demo mode these are ignored and reported as "mock" in /system/health.
CAREERFORGE_DATABASE_URL=postgresql+asyncpg://careerforge:careerforge@localhost:5432/careerforge
CAREERFORGE_QDRANT_URL=http://localhost:6333
CAREERFORGE_REDIS_URL=redis://localhost:6379/0
CAREERFORGE_OLLAMA_URL=http://localhost:11434
CAREERFORGE_TEMPORAL_URL=localhost:7233

# Local model served by the Ollama Model Gateway (used when APP_ENV != demo).
CAREERFORGE_OLLAMA_MODEL=qwen2.5-coder:7b
CAREERFORGE_EMBEDDING_MODEL=nomic-embed-text

# GitHub read-only access token (used only when a real GitHub client is wired
# up in a future phase). Leave blank in demo mode. Read-only scope only.
CAREERFORGE_GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Observability (optional; only active with the full docker-compose stack)
# -----------------------------------------------------------------------------
CAREERFORGE_LANGFUSE_HOST=http://localhost:3001
CAREERFORGE_LANGFUSE_PUBLIC_KEY=
CAREERFORGE_LANGFUSE_SECRET_KEY=
CAREERFORGE_PROMETHEUS_URL=http://localhost:9090

# -----------------------------------------------------------------------------
# Frontend (Next.js) — build/runtime public config
# -----------------------------------------------------------------------------
# Base URL the browser uses to reach the backend REST + SSE endpoints.
NEXT_PUBLIC_API_BASE=http://localhost:8000
